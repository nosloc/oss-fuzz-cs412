  375|  12.6k|  emit_byte(cinfo, 0x46);
  376|  12.6k|  emit_byte(cinfo, 0x49);
  377|  12.6k|  emit_byte(cinfo, 0x46);
  378|  12.6k|  emit_byte(cinfo, 0);
