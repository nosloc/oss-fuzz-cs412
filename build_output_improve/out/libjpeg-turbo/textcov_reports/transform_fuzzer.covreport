  383|  12.6k|  emit_2bytes(cinfo, (int)cinfo->Y_density);
  384|  12.6k|  emit_byte(cinfo, 0);          /* No thumbnail image */
  385|  12.6k|  emit_byte(cinfo, 0);
  386|  12.6k|}
